{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "routes": [
    { "src": "^/admin(/.*)?$", "headers": { "X-Frame-Options": "DENY", "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-cache" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "^/api/.*$", "status": 404 },
    { "src": "^/(.*)$", "dest": "/api/page?chemin=/$1" }
  ]
}
